# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your_secret_key_here

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<db-name>?retryWrites=true&w=majority
MONGODB_DB_NAME=fancy_store_db

# Store Configuration
STORE_NAME="Fancy Store"
STORE_EMAIL="support@fancystore.com"
STORE_PHONE="+91 98765 43210"
CURRENCY_SYMBOL="₹"
GST_RATE=18.0
FREE_SHIPPING_THRESHOLD=999.0
STANDARD_SHIPPING_CHARGE=49.0
